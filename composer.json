{
  "name": "kraenzle-ritter/clamav-scan",
  "description": "Scan files for malware with ClamAV: a small clamd client (INSTREAM over a Unix or TCP socket) and a fake scanner for tests.",
  "type": "library",
  "license": "MIT",
  "keywords": ["clamav", "clamd", "antivirus", "malware", "virus-scan", "archives", "digital-preservation"],
  "homepage": "https://github.com/kraenzle-ritter/clamav-scan",
  "support": {
    "issues": "https://github.com/kraenzle-ritter/clamav-scan/issues",
    "source": "https://github.com/kraenzle-ritter/clamav-scan"
  },
  "authors": [
    { "name": "Kraenzle & Ritter", "email": "info@k-r.ch" }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0|^12.0",
    "phpstan/phpstan": "^2.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "KraenzleRitter\\ClamavScan\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KraenzleRitter\\ClamavScan\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "format": "pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
